generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  BRANCH_MANAGER
  ACCOUNTANT
  INVENTORY_MANAGER
  RECEPTIONIST
  CRM_MANAGER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  PARTIALLY_PAID
  PAID
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SmsCampaignStatus {
  DRAFT
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum SmsRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  VOIDED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOIDED
}

model Organization {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  currency       String   @default("NGN")
  timezone       String   @default("Africa/Lagos")
  defaultTaxRate Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  branches          Branch[]
  members           OrganizationMember[]
  customers         Customer[]
  services          Service[]
  serviceCategories ServiceCategory[]
  products          Product[]
  sales             Sale[]
  auditLogs         AuditLog[]
  appointments      Appointment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  ledgerAccounts    LedgerAccount[]
  journalEntries    JournalEntry[]
  staffInvitations  StaffInvitation[]
  smsCampaigns      SmsCampaign[]
  manualBranches    ManualBranch[]
  branchStaff       BranchStaff[]
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  address        String?
  phone          String?
  email          String?
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization   Organization        @relation(fields: [organizationId], references: [id])
  memberships    BranchMembership[]
  inventory      InventoryBalance[]
  movements      InventoryMovement[]
  sales          Sale[]
  auditLogs      AuditLog[]
  appointments   Appointment[]
  expenses       Expense[]
  journalEntries JournalEntry[]

  staffInvitations StaffInvitationBranch[]
  customers        CustomerBranch[]
  smsCampaigns     SmsCampaign[]
  branchStaff      BranchStaff[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  memberships OrganizationMember[]
  sessions    Session[]
  accounts    Account[]

  @@map("user")
}

model OrganizationMember {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  userId         String     @db.Uuid
  role           MemberRole
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  organization             Organization       @relation(fields: [organizationId], references: [id])
  user                     User               @relation(fields: [userId], references: [id])
  branches                 BranchMembership[]
  salesCreated             Sale[]
  saleItemsAssigned        SaleItem[]         @relation("SaleItemAssignedMember")
  saleItemsPriceNegotiated SaleItem[]         @relation("SaleItemPriceNegotiatedBy")
  appointmentsAssigned     Appointment[]
  expensesSubmitted        Expense[]          @relation("ExpenseSubmittedBy")
  expensesApproved         Expense[]          @relation("ExpenseApprovedBy")
  journalEntriesCreated    JournalEntry[]     @relation("JournalEntryCreatedBy")
  auditLogs                AuditLog[]         @relation("AuditLogActor")
  staffInvitationsCreated  StaffInvitation[]  @relation("StaffInvitationCreator")
  createdSmsCampaigns      SmsCampaign[]      @relation("SmsCampaignCreator")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([organizationId, role, isActive])
}

model BranchMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  memberId       String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  branch Branch             @relation(fields: [branchId, organizationId], references: [id, organizationId])
  member OrganizationMember @relation(fields: [memberId, organizationId], references: [id, organizationId])

  @@unique([branchId, memberId])
  @@index([organizationId, memberId])
}

model BranchStaff {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  name           String
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId])
  saleItems    SaleItem[]   @relation("SaleItemAssignedBranchStaff")

  @@unique([id, organizationId])
  @@index([organizationId, branchId, isActive])
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  firstName      String
  lastName       String?
  phone          String
  email          String?
  dateOfBirth    DateTime?      @db.Date
  status         CustomerStatus @default(ACTIVE)
  whatsappOptIn  Boolean        @default(false)
  smsOptIn       Boolean        @default(false)
  notes          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization  Organization     @relation(fields: [organizationId], references: [id])
  sales         Sale[]
  appointments  Appointment[]
  branches      CustomerBranch[]
  smsRecipients SmsRecipient[]

  @@unique([organizationId, phone])
  @@unique([id, organizationId])
  @@index([organizationId, firstName, lastName])
  @@index([organizationId, email])
}

model ServiceCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  services     Service[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  categoryId     String   @db.Uuid
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  durationMins   Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization     Organization         @relation(fields: [organizationId], references: [id])
  category         ServiceCategory      @relation(fields: [categoryId, organizationId], references: [id, organizationId])
  saleItems        SaleItem[]
  appointmentItems AppointmentService[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, categoryId])
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  sku            String
  description    String?
  costPrice      Decimal       @db.Decimal(12, 2)
  sellingPrice   Decimal       @db.Decimal(12, 2)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  inventory    InventoryBalance[]
  movements    InventoryMovement[]
  saleItems    SaleItem[]

  @@unique([organizationId, sku])
  @@unique([id, organizationId])
  @@index([organizationId, name])
}

model InventoryBalance {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId, organizationId], references: [id, organizationId])
  product Product @relation(fields: [productId, organizationId], references: [id, organizationId])

  @@unique([branchId, productId])
  @@index([organizationId, productId])
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  branchId       String                @db.Uuid
  productId      String                @db.Uuid
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 3)
  referenceId    String?               @db.Uuid
  reason         String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId, organizationId], references: [id, organizationId])
  product Product @relation(fields: [productId, organizationId], references: [id, organizationId])

  @@index([organizationId, branchId, productId, createdAt])
}

model Sale {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  branchId          String     @db.Uuid
  customerId        String?    @db.Uuid
  createdByMemberId String?    @db.Uuid
  receiptNumber     String
  status            SaleStatus @default(DRAFT)
  subtotal          Decimal    @db.Decimal(12, 2)
  discount          Decimal    @default(0) @db.Decimal(12, 2)
  tax               Decimal    @default(0) @db.Decimal(12, 2)
  total             Decimal    @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  branch       Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId])
  customer     Customer?           @relation(fields: [customerId, organizationId], references: [id, organizationId])
  createdBy    OrganizationMember? @relation(fields: [createdByMemberId, organizationId], references: [id, organizationId])
  items        SaleItem[]
  payments     Payment[]

  @@unique([organizationId, receiptNumber])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, createdAt])
  @@index([customerId, createdAt])
}

model SaleItem {
  id                        String       @id @default(uuid()) @db.Uuid
  organizationId            String       @db.Uuid
  saleId                    String       @db.Uuid
  productId                 String?      @db.Uuid
  serviceId                 String?      @db.Uuid
  assignedMemberId          String?      @db.Uuid
  assignedMemberName        String?
  assignedBranchStaff       BranchStaff? @relation("SaleItemAssignedBranchStaff", fields: [assignedBranchStaffId, organizationId], references: [id, organizationId])
  stockBefore               Decimal?     @db.Decimal(12, 3)
  stockAfter                Decimal?     @db.Decimal(12, 3)
  description               String
  quantity                  Decimal      @db.Decimal(12, 3)
  unitPrice                 Decimal      @db.Decimal(12, 2)
  total                     Decimal      @db.Decimal(12, 2)
  originalUnitPrice         Decimal?     @db.Decimal(12, 2)
  priceDifference           Decimal?     @db.Decimal(12, 2)
  priceNegotiatedByMemberId String?      @db.Uuid
  priceNegotiatedAt         DateTime?    @db.Timestamptz(3)
  assignedBranchStaffId     String?      @db.Uuid

  sale              Sale                @relation(fields: [saleId, organizationId], references: [id, organizationId])
  product           Product?            @relation(fields: [productId, organizationId], references: [id, organizationId])
  service           Service?            @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  assignedMember    OrganizationMember? @relation("SaleItemAssignedMember", fields: [assignedMemberId, organizationId], references: [id, organizationId])
  priceNegotiatedBy OrganizationMember? @relation("SaleItemPriceNegotiatedBy", fields: [priceNegotiatedByMemberId, organizationId], references: [id, organizationId])

  @@index([organizationId, saleId])
  @@index([organizationId, productId])
  @@index([organizationId, serviceId])
  @@index([organizationId, assignedMemberId])
  @@index([organizationId, priceNegotiatedByMemberId])
  @@index([organizationId, assignedBranchStaffId])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  saleId         String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?       @unique
  idempotencyKey String?       @unique
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId, organizationId], references: [id, organizationId])

  @@index([organizationId, saleId, status])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String?  @db.Uuid
  actorMemberId  String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  branch       Branch?             @relation(fields: [branchId, organizationId], references: [id, organizationId])
  actor        OrganizationMember? @relation("AuditLogActor", fields: [actorMemberId, organizationId], references: [id, organizationId])

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([actorMemberId, createdAt])
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  branchId         String            @db.Uuid
  customerId       String            @db.Uuid
  assignedMemberId String?           @db.Uuid
  startsAt         DateTime          @db.Timestamptz(3)
  endsAt           DateTime          @db.Timestamptz(3)
  status           AppointmentStatus @default(PENDING)
  notes            String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  organization   Organization         @relation(fields: [organizationId], references: [id])
  branch         Branch               @relation(fields: [branchId, organizationId], references: [id, organizationId])
  customer       Customer             @relation(fields: [customerId, organizationId], references: [id, organizationId])
  assignedMember OrganizationMember?  @relation(fields: [assignedMemberId, organizationId], references: [id, organizationId])
  items          AppointmentService[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, startsAt])
  @@index([organizationId, customerId, startsAt])
  @@index([assignedMemberId, startsAt])
}

model AppointmentService {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  appointmentId  String   @db.Uuid
  serviceId      String   @db.Uuid
  serviceName    String
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  durationMins   Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId, organizationId], references: [id, organizationId])
  service     Service     @relation(fields: [serviceId, organizationId], references: [id, organizationId])

  @@unique([appointmentId, serviceId])
  @@index([organizationId, appointmentId])
  @@index([organizationId, serviceId])
}

model ExpenseCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  expenses     Expense[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model Expense {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @db.Uuid
  branchId            String        @db.Uuid
  categoryId          String        @db.Uuid
  submittedByMemberId String        @db.Uuid
  approvedByMemberId  String?       @db.Uuid
  description         String
  amount              Decimal       @db.Decimal(12, 2)
  vendor              String?
  reference           String?
  receiptUrl          String?
  status              ExpenseStatus @default(PENDING)
  expenseDate         DateTime      @db.Timestamptz(3)
  approvedAt          DateTime?     @db.Timestamptz(3)
  paidAt              DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  branch       Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId])
  category     ExpenseCategory     @relation(fields: [categoryId, organizationId], references: [id, organizationId])
  submittedBy  OrganizationMember  @relation("ExpenseSubmittedBy", fields: [submittedByMemberId, organizationId], references: [id, organizationId])
  approvedBy   OrganizationMember? @relation("ExpenseApprovedBy", fields: [approvedByMemberId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, branchId, expenseDate])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@index([submittedByMemberId, createdAt])
}

model LedgerAccount {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  code           String
  name           String
  type           AccountType
  description    String?
  isActive       Boolean     @default(true)
  isSystem       Boolean     @default(false)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id])
  journalLines JournalEntryLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model JournalEntry {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  branchId          String?            @db.Uuid
  createdByMemberId String?            @db.Uuid
  entryNumber       String
  description       String
  reference         String?
  status            JournalEntryStatus @default(DRAFT)
  entryDate         DateTime           @db.Timestamptz(3)
  postedAt          DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  branch       Branch?             @relation(fields: [branchId, organizationId], references: [id, organizationId])
  createdBy    OrganizationMember? @relation("JournalEntryCreatedBy", fields: [createdByMemberId, organizationId], references: [id, organizationId])
  lines        JournalEntryLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, entryNumber])
  @@index([organizationId, branchId, entryDate])
  @@index([organizationId, status])
}

model JournalEntryLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  journalEntryId String   @db.Uuid
  accountId      String   @db.Uuid
  description    String?
  debit          Decimal  @default(0) @db.Decimal(12, 2)
  credit         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  journalEntry JournalEntry  @relation(fields: [journalEntryId, organizationId], references: [id, organizationId])
  account      LedgerAccount @relation(fields: [accountId, organizationId], references: [id, organizationId])

  @@index([organizationId, journalEntryId])
  @@index([organizationId, accountId])
}

model StaffInvitation {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  createdByMemberId String     @db.Uuid
  email             String     @db.VarChar(254)
  role              MemberRole
  tokenHash         String     @unique @db.VarChar(64)
  expiresAt         DateTime   @db.Timestamptz(3)
  acceptedAt        DateTime?  @db.Timestamptz(3)
  revokedAt         DateTime?  @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id])
  createdBy    OrganizationMember      @relation("StaffInvitationCreator", fields: [createdByMemberId, organizationId], references: [id, organizationId])
  branches     StaffInvitationBranch[]

  @@unique([id, organizationId])
  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
}

model StaffInvitationBranch {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  invitationId   String @db.Uuid
  branchId       String @db.Uuid

  invitation StaffInvitation @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([invitationId, branchId])
  @@index([organizationId, branchId])
}

model CustomerBranch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  customerId     String   @db.Uuid
  branchId       String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerId, branchId])
  @@index([organizationId, branchId])
  @@index([organizationId, customerId])
}

model SmsCampaign {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  branchId          String?           @db.Uuid
  createdByMemberId String            @db.Uuid
  message           String
  senderId          String
  providerMessageId String?
  status            SmsCampaignStatus @default(DRAFT)
  recipientCount    Int               @default(0)
  sentCount         Int               @default(0)
  deliveredCount    Int               @default(0)
  failedCount       Int               @default(0)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id])
  branch       Branch?            @relation(fields: [branchId, organizationId], references: [id, organizationId])
  createdBy    OrganizationMember @relation("SmsCampaignCreator", fields: [createdByMemberId, organizationId], references: [id, organizationId])
  recipients   SmsRecipient[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([createdByMemberId])
}

model SmsRecipient {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  campaignId        String             @db.Uuid
  customerId        String?            @db.Uuid
  phone             String
  status            SmsRecipientStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?          @db.Timestamptz(3)
  deliveredAt       DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  campaign SmsCampaign @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([campaignId, phone])
  @@index([organizationId, campaignId, status])
  @@index([customerId])
}

model ManualBranch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  phone          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id])
  staff        ManualStaff[]
  entries      ManualPerformanceEntry[]

  @@unique([id, organizationId])
  @@index([organizationId, isActive])
}

model ManualStaff {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  name           String
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  branch  ManualBranch             @relation(fields: [branchId, organizationId], references: [id, organizationId])
  entries ManualPerformanceEntry[]

  @@unique([id, branchId, organizationId])
  @@index([organizationId, branchId, isActive])
}

model ManualPerformanceEntry {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  branchId        String   @db.Uuid
  staffId         String   @db.Uuid
  workDate        DateTime @db.Date
  revenue         Decimal  @db.Decimal(12, 2)
  notes           String?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  branch ManualBranch @relation(fields: [branchId, organizationId], references: [id, organizationId])
  staff  ManualStaff  @relation(fields: [staffId, branchId, organizationId], references: [id, branchId, organizationId])

  @@unique([staffId, workDate])
  @@index([organizationId, workDate])
  @@index([organizationId, branchId, workDate])
}
